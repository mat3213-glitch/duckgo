# Порт HTTP-сервера
PORT=8080

# Апстрим duck.ai (можно указать свой реверс-прокси)
BASE_URL=https://duck.ai

# Ключ доступа к этому сервису (проверяется как Bearer-токен). Пусто = без авторизации
TOKEN=

# Закреплённый токен сессии (x-vqd-hash-1), захваченный из браузера.
# Если пусто — сервис сам захватывает и решает челлендж автоматически
DUCK_HASH=

# Версия фронтенда для заголовка x-fe-version (обычно определяется автоматически)
FE_VERSION=

# Модель по умолчанию, если модель из запроса неизвестна
DEFAULT_MODEL=gpt-5.6-luna

# User-Agent для запросов к апстриму
USER_AGENT=
